# Canonical production origin used for SEO metadata.
# REQUIRED before launch: confirm domain ownership + DNS (owner action OA-2).
VITE_SITE_URL=https://novatech.et

# Public contact channels. Set these before launch if the defaults change.
# REQUIRED before launch: domain mailbox, e.g. hello@novatech.et (owner action OA-1).
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE_DISPLAY=+251 944 191 603
VITE_CONTACT_PHONE_HREF=tel:+251944191603
VITE_WHATSAPP_NUMBER=251944191603
VITE_TELEGRAM_HANDLE=@NovaTechET
VITE_TELEGRAM_URL=https://t.me/NovaTechET
VITE_LINKEDIN_URL=https://www.linkedin.com/company/novatech-et/
VITE_LOCATION_LABEL=Addis Ababa, Ethiopia
VITE_MAPS_URL=https://maps.google.com/?q=Addis%20Ababa%2C%20Ethiopia

# Optional API endpoint for contact form submissions.
# If missing, the homepage form falls back to a prefilled mailto flow.
VITE_CONTACT_API_ENDPOINT=

# Optional override for the formsubmit.co endpoint used by the homepage contact
# form. When empty, the URL is derived from VITE_CONTACT_EMAIL as
# https://formsubmit.co/ajax/<email>.
# REQUIRED before launch: activate formsubmit (or equivalent) forwarding for the
# final contact address (owner action OA-3).
VITE_CONTACT_FORM_SUBMIT_ENDPOINT=

# Optional API key sent as X-Api-Key with contact submissions.
VITE_CONTACT_API_KEY=

# Optional timeout for contact API requests (milliseconds).
VITE_CONTACT_TIMEOUT_MS=9000

# Nocatechai pricing guide mailing list capture.
# Frontend endpoint defaults to /api/mailing-list when omitted.
VITE_MAILING_LIST_ENDPOINT=/api/mailing-list
VITE_MAILING_LIST_API_KEY=
VITE_MAILING_LIST_TIMEOUT_MS=9000

# Server-side mailing list storage and forwarding.
MAILING_LIST_STORAGE_PATH=storage/mailing-list.jsonl
# REQUIRED before launch: webhook for the B18 delivery rail (owner action OA-6).
MAILING_LIST_WEBHOOK_URL=
# Bounded pending-retry file for failed webhook forwards (~500 rows, drained
# oldest-first, <=5 forwards per invocation). Leave at the default unless the
# runtime requires a writable path outside the project root.
MAILING_LIST_WEBHOOK_PENDING_PATH=storage/mailing-list-webhook-pending.jsonl
MAILING_LIST_NAME=nocatechai
MAILING_LIST_API_KEY=
MAILING_LIST_ALLOWED_ORIGIN=*

# Quote and discovery booking intake.
# Frontend endpoint defaults to /api/leads when omitted.
VITE_LEAD_INTAKE_ENDPOINT=/api/leads
VITE_LEAD_INTAKE_API_KEY=
VITE_LEAD_INTAKE_TIMEOUT_MS=9000

# Server-side lead intake storage and forwarding.
LEAD_INTAKE_STORAGE_PATH=storage/leads.jsonl
# REQUIRED before launch: webhook for the B18 delivery rail (owner action OA-6).
LEAD_INTAKE_WEBHOOK_URL=
# Bounded pending-retry file for failed webhook forwards (~500 rows, drained
# oldest-first, <=5 forwards per invocation). Leave at the default unless the
# runtime requires a writable path outside the project root.
LEAD_INTAKE_WEBHOOK_PENDING_PATH=storage/leads-webhook-pending.jsonl
LEAD_INTAKE_API_KEY=
LEAD_INTAKE_ALLOWED_ORIGIN=*

# Optional custom analytics endpoint.
# Events continue to publish to gtag/dataLayer when available.
VITE_ANALYTICS_ENDPOINT=

# REQUIRED before launch: GA4 Measurement ID (owner action OA-4) OR set
# VITE_ANALYTICS_ENDPOINT above. There is no analytics sink in production today.
VITE_GA4_MEASUREMENT_ID=

# Optional pricing data endpoint.
# Expected response shape: { "webPackages": [ ... ] }
# If absent or invalid, static pricing data is used.
VITE_PRICING_DATA_ENDPOINT=

# Optional SiteSpeak bot identifier used by the live chat dock.
# Default: f1f5fc15-c1e9-4d01-864b-1e7a756a61b4 (resolves today).
# REQUIRED before launch: confirm the production bot ID (owner action OA-5).
VITE_SITESPEAK_BOT_ID=
